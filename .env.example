# Environment variables for Hintly

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google OAuth2 Credentials
# Download from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Optional: Path to credentials JSON file
# GOOGLE_CREDENTIALS_PATH=credentials.json

# Output directories (optional, defaults shown)
# HINTLY_REPORTS_DIR=outputs/reports
# HINTLY_SOLUTIONS_DIR=outputs/solutions
# HINTLY_EXPORTS_DIR=outputs/exports
