# Environment variables for Hintly

# LLM Provider Configuration (Optional - for PDF summarization and form analysis)
# Choose provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic API (for Claude models)
ANTHROPIC_API_KEY=

# OpenAI API (for GPT models)
OPENAI_API_KEY=

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Path to credentials.json file
GOOGLE_CREDENTIALS_PATH=

# Optional: Custom output directories
# HINTLY_REPORTS_DIR=outputs/reports
# HINTLY_SOLUTIONS_DIR=outputs/solutions
# HINTLY_EXPORTS_DIR=outputs/exports
